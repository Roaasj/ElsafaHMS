# ===== إعدادات نظام مستشفى الصفا =====
# انسخ الملف ده باسم .env وعدّل القيم

PORT=3000
HOSPITAL_NAME=مستشفى الصفا دمياط
SESSION_HOURS=12

# sqlite = تجربة سريعة على أي جهاز (ملف في فولدر data)
# mssql  = SQL Server
DB_DRIVER=mssql

MSSQL_SERVER=localhost
# لو SQL Server متسطب باسم (Named Instance) زي SQLEXPRESS اكتبه هنا وسيب البورت فاضي
MSSQL_INSTANCE=
MSSQL_PORT=1433
MSSQL_DATABASE=ElsafaHMS
MSSQL_USER=elsafa_hms
MSSQL_PASSWORD=ضع_كلمة_السر_هنا
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

# خليها true لما نشغل https
COOKIE_SECURE=false
